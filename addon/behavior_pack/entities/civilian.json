                    "superhuman:v1"
                  ]
                }
              },
              {
                "weight": 1,
                "add": {
                  "component_groups": [
                    "superhuman:v2"
                  ]
                }
              },
              {
                "weight": 1,
                "add": {
                  "component_groups": [
                    "superhuman:v3"
                  ]
                }
              },
              {
                "weight": 1,
                "add": {
                  "component_groups": [
                    "superhuman:v4"
                  ]
                }
              },
              {
                "weight": 1,
                "add": {
                  "component_groups": [
                    "superhuman:v5"
                  ]
                }
              }
            ]
          }
        ]
      },
      "superhuman:interacted": {},
      "superhuman:start_carry": {
        "add": {
          "component_groups": [
            "superhuman:carried"
          ]
        },
        "remove": {
          "component_groups": [
            "superhuman:free"
          ]
        }
      },
      "superhuman:stop_carry": {
        "add": {
          "component_groups": [
            "superhuman:free"
          ]
        },
        "remove": {
          "component_groups": [
            "superhuman:carried"
          ]
        }
      }
    }
  }
}
