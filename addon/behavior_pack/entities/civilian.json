{
  "format_version": "1.26.10",
  "minecraft:entity": {
    "description": {
      "identifier": "superhuman:civilian",
      "is_spawnable": true,
      "is_summonable": true,
      "spawn_category": "creature",
      "properties": {
        "superhuman:state": {
          "type": "enum",
          "values": [
            "idle",
            "danger",
            "carried",
            "cheer"
          ],
          "default": "idle",
          "client_sync": true
        }
      }
    },
    "component_groups": {
      "superhuman:v0": {
        "minecraft:variant": {
          "value": 0
        }
      },
      "superhuman:v1": {
        "minecraft:variant": {
          "value": 1
        }
      },
      "superhuman:v2": {
        "minecraft:variant": {
          "value": 2
        }
      },
      "superhuman:v3": {
        "minecraft:variant": {
          "value": 3
        }
      },
      "superhuman:v4": {
        "minecraft:variant": {
          "value": 4
        }
      },
      "superhuman:v5": {
        "minecraft:variant": {
          "value": 5
        }
      },
      "superhuman:free": {
        "minecraft:physics": {},
        "minecraft:pushable_by_entity": {},
        "minecraft:pushable_by_block": {},
        "minecraft:damage_sensor": {
          "triggers": [
            {
              "cause": "fall",
              "deals_damage": "no"
            },
            {
              "on_damage": {
                "filters": {
                  "test": "is_family",
                  "subject": "other",
                  "value": "player"
                }
              },
              "deals_damage": "no"
            }
          ]
        }
      },
      "superhuman:carried": {
        "minecraft:physics": {
          "has_gravity": false,
          "has_collision": false
        },
        "minecraft:damage_sensor": {
          "triggers": [
            {
              "cause": "all",
              "deals_damage": "no"
            }
          ]
        }
      }
    },
    "components": {
      "minecraft:type_family": {
        "family": [
          "civilian",
          "mob"
        ]
      },
      "minecraft:health": {
        "value": 20,
        "max": 20
      },
      "minecraft:collision_box": {
        "width": 0.6,
        "height": 1.8
      },
      "minecraft:movement": {
        "value": 0.25
      },
      "minecraft:movement.basic": {},
      "minecraft:navigation.walk": {
        "can_path_over_water": true,
        "avoid_water": true,
        "avoid_damage_blocks": true,
        "can_open_doors": true
      },
      "minecraft:jump.static": {},
      "minecraft:can_climb": {},
      "minecraft:follow_range": {
        "value": 16,
        "max": 16
      },
      "minecraft:breathable": {
        "total_supply": 15,
        "suffocate_time": 0
      },
      "minecraft:nameable": {},
      "minecraft:conditional_bandwidth_optimization": {},
      "minecraft:persistent": {},
      "minecraft:home": {
        "restriction_radius": 32,
        "restriction_type": "random_movement"
      },
      "minecraft:interact": {
        "interactions": [
          {
            "on_interact": {
              "filters": {
                "test": "is_family",
                "subject": "other",
                "value": "player"
              },
              "event": "superhuman:interacted",
              "target": "self"
            },
            "interact_text": "action.interact.superhuman_rescue",
            "swing": true
          }
        ]
      },
      "minecraft:behavior.panic": {
        "priority": 1,
        "speed_multiplier": 1.6
      },
      "minecraft:behavior.avoid_mob_type": {
        "priority": 2,
        "entity_types": [
          {
            "filters": {
              "any_of": [
                {
                  "test": "is_family",
                  "subject": "other",
                  "value": "villain"
                },
                {
                  "test": "is_family",
                  "subject": "other",
                  "value": "monster"
                }
              ]
            },
            "max_dist": 10,
            "walk_speed_multiplier": 1.2,
            "sprint_speed_multiplier": 1.5
          }
        ]
      },
      "minecraft:behavior.move_towards_home_restriction": {
        "priority": 5,
        "speed_multiplier": 0.9
      },
      "minecraft:behavior.float": {
        "priority": 0
      },
      "minecraft:behavior.random_stroll": {
        "priority": 6,
        "speed_multiplier": 0.9
      },
      "minecraft:behavior.look_at_player": {
        "priority": 7,
        "look_distance": 10,
        "probability": 0.05
      },
      "minecraft:behavior.random_look_around": {
        "priority": 8
      }
    },
    "events": {
      "minecraft:entity_spawned": {
        "sequence": [
          {
            "add": {
              "component_groups": [
                "superhuman:free"
              ]
            }
          },
          {
            "randomize": [
              {
                "weight": 1,
                "add": {
                  "component_groups": [
                    "superhuman:v0"
                  ]
                }
              },
              {
                "weight": 1,
                "add": {
