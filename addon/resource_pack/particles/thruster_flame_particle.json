{
  "format_version": "1.10.0",
  "particle_effect": {
    "description": {
      "identifier": "superhuman:thruster_flame_particle",
      "basic_render_parameters": {
        "material": "particles_blend",
        "texture": "textures/particle/superhuman_particles"
      }
    },
    "components": {
      "minecraft:emitter_rate_instant": {
        "num_particles": 3
      },
      "minecraft:emitter_lifetime_once": {
        "active_time": 0
      },
      "minecraft:emitter_shape_point": {
        "direction": [
          "(variable.jet.direction_x ?? 0) + (variable.particle_random_1 - 0.5) * 0.3",
          "(variable.jet.direction_y ?? -1) + (variable.particle_random_2 - 0.5) * 0.3",
          "(variable.jet.direction_z ?? 0) + (variable.particle_random_3 - 0.5) * 0.3"
        ]
      },
      "minecraft:particle_lifetime_expression": {
        "max_lifetime": "0.22"
      },
      "minecraft:particle_initial_speed": "(variable.jet.speed ?? 2) * (0.7 + variable.particle_random_4 * 0.6)",
      "minecraft:particle_motion_dynamic": {
        "linear_drag_coefficient": 2.0
      },
      "minecraft:particle_appearance_billboard": {
        "size": [
          "0.16 - variable.particle_age * 0.5",
          "0.16 - variable.particle_age * 0.5"
        ],
        "facing_camera_mode": "lookat_xyz",
        "uv": {
          "texture_width": 64,
          "texture_height": 64,
          "uv": [
            16,
            32
          ],
          "uv_size": [
            16,
            16
          ]
        }
      },
      "minecraft:particle_appearance_tinting": {
        "color": {
          "gradient": {
            "0.0": [
              1,
              1,
              0.95,
              1
            ],
            "0.3": [
              1,
              0.85,
              0.35,
              0.95
            ],
            "1.0": [
              1,
              0.35,
              0.05,
              0
            ]
          },
          "interpolant": "variable.particle_age / variable.particle_lifetime"
        }
      }
    }
  }
}
