{
  "format_version": "1.10.0",
  "particle_effect": {
    "description": {
      "identifier": "superhuman:freeze_breath_particle",
      "basic_render_parameters": {
        "material": "particles_blend",
        "texture": "textures/particle/superhuman_particles"
      }
    },
    "components": {
      "minecraft:emitter_rate_instant": {
        "num_particles": 3
      },
      "minecraft:emitter_lifetime_once": {
        "active_time": 0
      },
      "minecraft:emitter_shape_point": {
        "direction": [
          "(variable.breath.direction_x ?? 0) + (variable.particle_random_1 - 0.5) * 0.35",
          "(variable.breath.direction_y ?? 0) + (variable.particle_random_2 - 0.5) * 0.35",
          "(variable.breath.direction_z ?? 1) + (variable.particle_random_3 - 0.5) * 0.35"
        ]
      },
      "minecraft:particle_lifetime_expression": {
        "max_lifetime": "0.7"
      },
      "minecraft:particle_initial_speed": "(variable.breath.speed ?? 10) * (0.8 + variable.particle_random_4 * 0.4)",
      "minecraft:particle_motion_dynamic": {
        "linear_drag_coefficient": 2.2
      },
      "minecraft:particle_appearance_billboard": {
        "size": [
          "0.08 + variable.particle_age * 0.7",
          "0.08 + variable.particle_age * 0.7"
        ],
        "facing_camera_mode": "lookat_xyz",
        "uv": {
          "texture_width": 64,
          "texture_height": 64,
          "uv": [
            16,
            16
          ],
          "uv_size": [
            16,
            16
          ]
        }
      },
      "minecraft:particle_appearance_tinting": {
        "color": {
          "gradient": {
            "0.0": [
              0.88,
              0.97,
              1.0,
              0.85
            ],
            "1.0": [
              0.6,
              0.85,
              1.0,
              0.0
            ]
          },
          "interpolant": "variable.particle_age / variable.particle_lifetime"
        }
      }
    }
  }
}
