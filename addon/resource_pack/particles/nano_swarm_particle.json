{
  "format_version": "1.10.0",
  "particle_effect": {
    "description": {
      "identifier": "superhuman:nano_swarm_particle",
      "basic_render_parameters": {
        "material": "particles_alpha",
        "texture": "textures/particle/superhuman_particles"
      }
    },
    "components": {
      "minecraft:emitter_rate_instant": {
        "num_particles": 2
      },
      "minecraft:emitter_lifetime_once": {
        "active_time": 0
      },
      "minecraft:emitter_shape_point": {
        "direction": [
          "(variable.nano.direction_x ?? 0) + (variable.particle_random_1 - 0.5) * 0.5",
          "(variable.nano.direction_y ?? 0) + (variable.particle_random_2 - 0.5) * 0.5",
          "(variable.nano.direction_z ?? 0) + (variable.particle_random_3 - 0.5) * 0.5"
        ]
      },
      "minecraft:particle_lifetime_expression": {
        "max_lifetime": "0.4"
      },
      "minecraft:particle_initial_speed": "variable.nano.speed ?? 1.5",
      "minecraft:particle_motion_dynamic": {
        "linear_drag_coefficient": 1.0
      },
      "minecraft:particle_appearance_billboard": {
        "size": [
          "0.05",
          "0.05"
        ],
        "facing_camera_mode": "lookat_xyz",
        "uv": {
          "texture_width": 64,
          "texture_height": 64,
          "uv": [
            0,
            32
          ],
          "uv_size": [
            16,
            16
          ]
        }
      },
      "minecraft:particle_appearance_tinting": {
        "color": [
          "variable.particle_random_4 > 0.5 ? 0.95 : 0.75",
          "variable.particle_random_4 > 0.5 ? 0.72 : 0.08",
          "variable.particle_random_4 > 0.5 ? 0.22 : 0.1",
          1.0
        ]
      }
    }
  }
}
