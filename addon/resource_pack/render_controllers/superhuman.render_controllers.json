{
  "format_version": "1.10.0",
  "render_controllers": {
    "controller.render.superhuman.civilian": {
      "arrays": {
        "textures": {
          "Array.skins": [
            "Texture.v0",
            "Texture.v1",
            "Texture.v2",
            "Texture.v3",
            "Texture.v4",
            "Texture.v5"
          ]
        }
      },
      "geometry": "Geometry.default",
      "materials": [
        {
          "*": "Material.default"
        }
      ],
      "textures": [
        "Array.skins[query.variant]"
      ]
    },
    "controller.render.superhuman.thug": {
      "arrays": {
        "textures": {
          "Array.skins": [
            "Texture.v0",
            "Texture.v1"
          ]
        }
      },
      "geometry": "Geometry.default",
      "materials": [
        {
          "*": "Material.default"
        }
      ],
      "textures": [
        "Array.skins[query.variant]"
      ]
    },
    "controller.render.superhuman.default": {
      "geometry": "Geometry.default",
      "materials": [
        {
          "*": "Material.default"
        }
      ],
      "textures": [
        "Texture.default"
      ]
    },
    "controller.render.superhuman.suit": {
      "geometry": "Geometry.default",
      "materials": [
        {
          "*": "variable.is_enchanted ? Material.enchanted : Material.default"
        }
      ],
      "textures": [
        "Texture.default",
        "Texture.enchanted"
      ]
    }
  }
}
